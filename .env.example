ANTHROPIC_API_KEY=sk-ant-...
# Required for user-scoped keys (sk-ant-usr-...). Find it in the console under
# Settings > Workspaces. Workspace-scoped keys can leave this blank.
ANTHROPIC_WORKSPACE_ID=
PORT=3000
# Optional. Where Claude Code keeps transcripts. Defaults to ~/.claude/projects
# (%USERPROFILE%\.claude\projects on Windows).
# CLAUDE_PROJECTS_DIR=
